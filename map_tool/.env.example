# Copy to .env and adjust. All values are optional; defaults shown below.

# --- Remote ROS 2 system (rosbridge WebSocket) ---
ROS_BRIDGE_IP=192.168.1.100
ROS_BRIDGE_PORT=9090
ODOM_TOPIC=/odometry/filtered
ODOM_TYPE=nav_msgs/msg/Odometry

# --- Backend HTTP server ---
# 0.0.0.0 is a *listen* address: the browser still connects to
# http://localhost:8001 (or this machine's actual LAN IP).
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8001
DEBUG=false

# --- Security (LAN deployments) ---
# Set a non-empty value to require the X-API-Key header on /api/* and a
# ?key= query param on the /ws/live WebSocket.
API_KEY=

# --- Rosbag storage ---
ROSBAG_UPLOAD_DIR=./recordings/uploads
ROSBAG_CACHE_DIR=./recordings/cache
MAX_UPLOAD_SIZE_MB=500

# --- Connection tuning ---
ROSBRIDGE_TIMEOUT_SEC=5
ROSBRIDGE_RECONNECT_MAX_SEC=30
ROSBRIDGE_HEARTBEAT_INTERVAL_SEC=5
ROSBRIDGE_HEARTBEAT_TIMEOUT_SEC=10

# --- Frame convention ---
# Added to every extracted yaw. Leave 0 for a standard ENU frame (yaw=0 -> East).
HEADING_OFFSET_DEG=0
